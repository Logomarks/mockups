{
  "name": "@arraypress/mockups",
  "version": "0.1.0",
  "description": "Product mockups from finished artwork: vinyl, CD, cassette, poster, business cards, letterhead, tickets, stickers, apparel, mugs, bags, boxes, phone, laptop, billboard, shopfront and bus shelter. Dependency-free layered SVG, PNG via sharp in Node or a canvas in the browser, and three.js scenes for 3D shots.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/render/node.d.ts",
      "import": "./src/render/node.js",
      "default": "./src/render/node.js"
    },
    "./browser": {
      "types": "./src/render/browser.d.ts",
      "import": "./src/render/browser.js",
      "default": "./src/render/browser.js"
    },
    "./3d": {
      "types": "./src/three/index.d.ts",
      "import": "./src/three/index.js",
      "default": "./src/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "album-art",
    "apparel",
    "billboard",
    "business-card",
    "cassette",
    "cd",
    "cover-art",
    "lp",
    "merch",
    "mockup",
    "mockups",
    "poster",
    "product-mockup",
    "record",
    "sharp",
    "sleeve",
    "svg",
    "three",
    "vinyl",
    "webgl"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/mockups.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^6.0.3"
  }
}
