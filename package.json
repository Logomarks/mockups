{
  "name": "@logomarks/mockups",
  "version": "0.6.0",
  "description": "Product mockups from finished artwork: vinyl, CD, cassette, poster, business cards, letterhead, tickets, wristbands, stickers, apparel, mugs, bags, boxes, phone, laptop, billboard, shopfront and bus shelter. Dependency-free layered SVG, PNG via sharp in Node or a canvas in the browser, and three.js scenes shot through a lens: sunglasses reflecting the art, a phone macro, a keynote stage, neon, a station lightbox, a window decal, binders, a book in a slipcase, stationery, and restaurant menus, receipts, cups, bags, pizza boxes, chopsticks and napkins. Photo plates composite art into real photos: flat signs, round labels, cup sleeves and cloth, printed, debossed, embossed, engraved or foiled.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/render/node.d.ts",
      "import": "./src/render/node.js",
      "default": "./src/render/node.js"
    },
    "./browser": {
      "types": "./src/render/browser.d.ts",
      "import": "./src/render/browser.js",
      "default": "./src/render/browser.js"
    },
    "./3d": {
      "types": "./src/three/index.d.ts",
      "import": "./src/three/index.js",
      "default": "./src/three/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "album-art",
    "apparel",
    "billboard",
    "binder",
    "business-card",
    "cassette",
    "cd",
    "coffee-cup",
    "cover-art",
    "deboss",
    "depth-of-field",
    "emboss",
    "engraving",
    "foil",
    "halftone",
    "keynote",
    "lightbox",
    "lp",
    "menu",
    "merch",
    "mockup",
    "mockups",
    "napkin",
    "neon",
    "photo-plates",
    "pizza-box",
    "poster",
    "product-mockup",
    "receipt",
    "record",
    "restaurant",
    "sharp",
    "sleeve",
    "stationery",
    "sunglasses",
    "svg",
    "television",
    "three",
    "vinyl",
    "webgl",
    "wristband"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Logomarks/mockups.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0",
    "three": ">=0.160.0",
    "@logomarks/image-effects": ">=0.4.2"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@logomarks/image-effects": {
      "optional": true
    }
  },
  "devDependencies": {
    "@logomarks/image-effects": "^0.4.2",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "typescript": "^6.0.3"
  },
  "homepage": "https://www.npmjs.com/package/@logomarks/mockups"
}
